# Exemple documentaire uniquement. Ne pas committer de vrais secrets.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000

# IDR-005 P1: local Next.js server-side proxy only; never NEXT_PUBLIC_*
DJANGO_PROXY_ORIGIN=http://127.0.0.1:8000
