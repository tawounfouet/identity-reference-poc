{
  "name": "identity-reference-poc-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.28.12",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
